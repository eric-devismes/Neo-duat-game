# --- Supabase (required) ---
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- App ---
# Public URL of the deployed app, used to build QR payloads (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Sheets sync (optional, for /api/sheets/sync) ---
# Create a service account in Google Cloud, enable the Sheets API,
# then SHARE the target spreadsheet with the service account email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
